{
  "name": "workspot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "api": "tsx --env-file=.env worker/src/node.ts",
    "db:up": "docker compose up -d",
    "db:migrate": "tsx --env-file=.env tools/migrate.ts",
    "db:seed": "tsx --env-file=.env tools/seed.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "deploy": "npm run build && wrangler deploy -c worker/wrangler.toml"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@neon/config": "^1.1.0",
    "@neon/env": "^1.1.6",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.7",
    "maplibre-gl": "^6.6.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.127.1"
  }
}
